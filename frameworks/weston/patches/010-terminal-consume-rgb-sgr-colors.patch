Subject: [PATCH] terminal: consume extended SGR colors as complete attributes

Map RGB foreground/background colors to the existing cell palette. Consume
indexed colors without dropping subsequent attributes, and reject malformed
color payloads without treating components as independent commands.

---

--- a/clients/terminal.c
+++ b/clients/terminal.c
@@ -1316,6 +1316,71 @@
 	}
 }
 
+/* Cell attributes store palette indices. Map RGB to the nearest existing
+ * palette entry rather than interpreting its components as SGR commands. */
+static int
+terminal_rgb_index(struct terminal *terminal, int r, int g, int b)
+{
+	double best = 4.0;
+	int index = 0, i;
+
+	for (i = 0; i < 256; i++) {
+		double dr = terminal->color_table[i].r - r / 255.0;
+		double dg = terminal->color_table[i].g - g / 255.0;
+		double db = terminal->color_table[i].b - b / 255.0;
+		double distance = dr * dr + dg * dg + db * db;
+
+		if (distance < best) {
+			best = distance;
+			index = i;
+		}
+	}
+
+	return index;
+}
+
+static void
+terminal_handle_sgr(struct terminal *terminal, int *args, int *set, int count)
+{
+	int i, j, components, index;
+
+	if (!set[0]) {
+		handle_sgr(terminal, 0);
+		return;
+	}
+
+	for (i = 0; i < count && set[i]; i++) {
+		if (args[i] != 38 && args[i] != 48) {
+			handle_sgr(terminal, args[i]);
+			continue;
+		}
+
+		/* Consume a complete extended color atomically. Invalid or
+		 * truncated payloads must not change bold, blink, or other state. */
+		if (i + 1 >= count || !set[i + 1])
+			return;
+		if (args[i + 1] == 5)
+			components = 1;
+		else if (args[i + 1] == 2)
+			components = 3;
+		else
+			return;
+		if (i + 1 + components >= count)
+			return;
+		for (j = 0; j < components; j++) {
+			if (!set[i + 2 + j] || args[i + 2 + j] < 0 ||
+			    args[i + 2 + j] > 255)
+				return;
+		}
+		index = args[i + 2];
+		if (components == 3)
+			index = terminal_rgb_index(terminal, args[i + 2],
+					   args[i + 3], args[i + 4]);
+		handle_sgr(terminal, index + (args[i] == 38 ? 256 : 512));
+		i += 1 + components;
+	}
+}
+
