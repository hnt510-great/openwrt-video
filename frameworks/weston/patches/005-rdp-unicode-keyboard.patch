 	struct wl_listener input_seat_destroy;
 	struct wl_array pressed_keys;
+	struct wl_event_source *unicode_timer;
+	uint32_t unicode_queue[256];
+	unsigned int unicode_count;
+	uint16_t unicode_high_surrogate;
 
 	bool button_state[5];
 
