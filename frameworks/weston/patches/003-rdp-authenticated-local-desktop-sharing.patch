 static BOOL
+xf_peer_logon(freerdp_peer *client, const SEC_WINNT_AUTH_IDENTITY *identity,
+	      BOOL automatic)
+{
+	struct passwd *pw;
+	const char *username;
+	char *decoded = NULL;
+	bool allowed;
+
+	if (!automatic)
+		return FALSE;
+	/* Recent FreeRDP stores decoded CredSSP credentials in settings;
+	 * older versions populate the callback identity instead.
+	 */
+	username = freerdp_settings_get_string(client->context->settings, FreeRDP_Username);
+	if ((!username || !*username) && identity->User && identity->UserLength) {
+		if (identity->Flags & SEC_WINNT_AUTH_IDENTITY_UNICODE)
+			decoded = ConvertWCharNToUtf8Alloc(
+				identity->User, identity->UserLength, NULL);
+		else
+			decoded = strndup((const char *)identity->User, identity->UserLength);
+		username = decoded;
+	}
+	if (!username || !*username)
+		return FALSE;
+	pw = getpwnam(username);
+	allowed = pw && pw->pw_uid >= 1000 && pw->pw_uid == getuid();
+	free(decoded);
+	return allowed;
+}
