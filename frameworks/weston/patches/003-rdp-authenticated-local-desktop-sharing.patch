+/* Mirrored clients use the local seat so existing GTK/Xwayland windows
+ * receive input. A peer still owns its private seat for standalone use.
+ */
+static void
+rdp_send_key(RdpPeerContext *ctx, uint32_t key,
+	     enum wl_keyboard_key_state state)
+{
+	struct weston_key_event event;
+	struct timespec time;
+	uint32_t *held, *last;
+	bool found = false;
+
+	if (!ctx->item.seat)
+		return;
+	wl_array_for_each(held, &ctx->pressed_keys) {
+		if (*held != key)
+			continue;
+		found = true;
+		if (state == WL_KEYBOARD_KEY_STATE_RELEASED) {
+			last = (uint32_t *)((char *)ctx->pressed_keys.data +
+				ctx->pressed_keys.size) - 1;
+			*held = *last;
+			ctx->pressed_keys.size -= sizeof(*held);
+		}
+		break;
+	}
+	if (!found && state == WL_KEYBOARD_KEY_STATE_RELEASED)
+		return;
+	if (!found && state == WL_KEYBOARD_KEY_STATE_PRESSED) {
+		struct weston_keyboard *keyboard = weston_seat_get_keyboard(ctx->item.seat);
+
+		/* Do not take ownership of a key already held locally. */
+		if (ctx->item.seat != ctx->private_seat && keyboard) {
+			wl_array_for_each(held, &keyboard->keys) {
+				if (*held == key)
+					return;
+			}
+		}
+		held = wl_array_add(&ctx->pressed_keys, sizeof(*held));
+		if (!held)
+			return;
+		*held = key;
+	}
+	clock_gettime(CLOCK_MONOTONIC, &time);
+	weston_key_event_init(&event, &time, ctx->item.seat, key, state,
+			      STATE_UPDATE_AUTOMATIC);
+	notify_key(&event);
+}
+
+static void
+rdp_input_seat_destroyed(struct wl_listener *listener, void *data)
+{
+	RdpPeerContext *ctx = wl_container_of(listener, ctx, input_seat_destroy);
+
+	(void)data;
+	wl_list_remove(&ctx->input_seat_destroy.link);
+	ctx->item.seat = ctx->private_seat;
+	weston_seat_init_keyboard(ctx->private_seat, NULL);
+	weston_seat_init_pointer(ctx->private_seat);
+	ctx->pressed_keys.size = 0;
+	memset(ctx->button_state, 0, sizeof(ctx->button_state));
+}
+
+static void
+rdp_share_mirror_seat(RdpPeerContext *ctx, struct weston_output *output)
+{
+	struct weston_seat *seat;
+
+	if (!output->mirror_of)
+		return;
+	wl_list_for_each(seat, &ctx->rdpBackend->compositor->seat_list, link) {
+		if (seat == ctx->private_seat ||
+		    strcmp(seat->seat_name, "VNC Client") == 0 ||
+		    strncmp(seat->seat_name, "RDP ", 4) == 0)
+			continue;
+		weston_seat_init_pointer(seat);
+		if (weston_seat_init_keyboard(seat, NULL) < 0) {
+			weston_seat_release_pointer(seat);
+			return;
+		}
+		/* An unused keyboard would become a second Xwayland master device. */
+		if (ctx->private_seat->keyboard_device_count)
+			weston_seat_release_keyboard(ctx->private_seat);
+		ctx->item.seat = seat;
+		ctx->input_seat_destroy.notify = rdp_input_seat_destroyed;
+		wl_signal_add(&seat->destroy_signal, &ctx->input_seat_destroy);
+		return;
+	}
+}
+
+static void
+rdp_release_input(RdpPeerContext *ctx)
+{
+	struct weston_key_event key_event;
+	struct weston_pointer_button_event button_event;
+	struct timespec time;
+	uint32_t *held;
+	unsigned int i;
+
+	if (ctx->item.seat) {
+		clock_gettime(CLOCK_MONOTONIC, &time);
+		wl_array_for_each(held, &ctx->pressed_keys) {
+			weston_key_event_init(&key_event, &time, ctx->item.seat, *held,
+				WL_KEYBOARD_KEY_STATE_RELEASED, STATE_UPDATE_AUTOMATIC);
+			notify_key(&key_event);
+		}
+		for (i = 0; i < ARRAY_LENGTH(ctx->button_state); i++) {
+			if (!ctx->button_state[i])
+				continue;
+			weston_pointer_button_event_init(&button_event, &time,
+				ctx->item.seat, BTN_LEFT + i,
+				WL_POINTER_BUTTON_STATE_RELEASED);
+			notify_button(&button_event);
+		}
+		notify_pointer_frame(ctx->item.seat);
+		if (ctx->item.seat != ctx->private_seat) {
+			wl_list_remove(&ctx->input_seat_destroy.link);
+			weston_seat_release_keyboard(ctx->item.seat);
+			weston_seat_release_pointer(ctx->item.seat);
+		}
+	}
+	wl_array_release(&ctx->pressed_keys);
+	if (ctx->private_seat) {
+		if (ctx->private_seat->keyboard_device_count)
+			weston_seat_release_keyboard(ctx->private_seat);
+		if (ctx->private_seat->pointer_device_count)
+			weston_seat_release_pointer(ctx->private_seat);
+		weston_seat_release(ctx->private_seat);
+		free(ctx->private_seat);
+	}
+	ctx->item.seat = NULL;
+	ctx->private_seat = NULL;
+}
