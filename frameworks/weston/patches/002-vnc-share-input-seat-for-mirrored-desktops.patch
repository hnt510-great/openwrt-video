+/* Mirrored desktops share the local input seat. GTK uses a single default
+ * seat, so forwarding to a separate per-client seat leaves GTK apps without
+ * remote input. The peer retains its private seat for standalone VNC and
+ * for fallback when the local seat disappears.
+ */
+static void
+vnc_input_seat_destroyed(struct wl_listener *listener, void *data)
+{
+	struct vnc_peer *peer = wl_container_of(listener, peer, input_seat_destroy);
+
+	(void)data;
+	wl_list_remove(&peer->input_seat_destroy.link);
+	peer->input_seat = peer->seat;
+	peer->pressed_keys.size = 0;
+	peer->last_button_mask = 0;
+}
+
+static void
+vnc_share_mirror_seat(struct vnc_peer *peer)
+{
+	struct weston_seat *seat;
+
+	if (!peer->backend->output->base.mirror_of)
+		return;
+
+	wl_list_for_each(seat, &peer->backend->compositor->seat_list, link) {
+		if (seat == peer->seat || strcmp(seat->seat_name, "VNC Client") == 0)
+			continue;
+
+		weston_seat_init_pointer(seat);
+		if (weston_seat_init_keyboard(seat, peer->backend->xkb_keymap) < 0) {
+			weston_seat_release_pointer(seat);
+			return;
+		}
+		peer->input_seat = seat;
+		peer->input_seat_destroy.notify = vnc_input_seat_destroyed;
+		wl_signal_add(&seat->destroy_signal, &peer->input_seat_destroy);
+		return;
+	}
+}
+
+static void
+vnc_send_key(struct vnc_peer *peer, uint32_t key,
+	     enum wl_keyboard_key_state state,
+	     enum weston_key_state_update update)
+{
+	struct weston_key_event event;
+	struct timespec time;
+	uint32_t *held, *last;
+	bool found = false;
+
+	wl_array_for_each(held, &peer->pressed_keys) {
+		if (*held != key)
+			continue;
+		found = true;
+		if (state == WL_KEYBOARD_KEY_STATE_RELEASED) {
+			last = (uint32_t *)((char *)peer->pressed_keys.data +
+				peer->pressed_keys.size) - 1;
+			*held = *last;
+			peer->pressed_keys.size -= sizeof(*held);
+		}
+		break;
+	}
+	if (!found && state == WL_KEYBOARD_KEY_STATE_PRESSED) {
+		held = wl_array_add(&peer->pressed_keys, sizeof(*held));
+		if (!held)
+			return;
+		*held = key;
+	}
+	if (!found && state == WL_KEYBOARD_KEY_STATE_RELEASED &&
+	    peer->input_seat != peer->seat)
+		return;
+
+	weston_compositor_get_time(&time);
+	weston_key_event_init(&event, &time, peer->input_seat, key, state, update);
+	notify_key(&event);
+}
