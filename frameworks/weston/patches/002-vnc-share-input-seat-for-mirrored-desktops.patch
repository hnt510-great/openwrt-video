 	struct vnc_peer *peer = userdata;
 	struct vnc_output *output = peer->backend->output;
 
+	struct weston_key_event key_event;
+	struct weston_pointer_button_event button_event;
+	struct timespec time;
+	uint32_t *held;
+	const uint32_t masks[] = { NVNC_BUTTON_LEFT, NVNC_BUTTON_MIDDLE, NVNC_BUTTON_RIGHT };
+	const uint32_t buttons[] = { BTN_LEFT, BTN_MIDDLE, BTN_RIGHT };
+	size_t i;
+
+	/* A disconnected client must not leave modifiers or buttons depressed
+	 * on the shared local seat.
+	 */
+	weston_compositor_get_time(&time);
+	wl_array_for_each(held, &peer->pressed_keys) {
+		weston_key_event_init(&key_event, &time, peer->input_seat, *held,
+			WL_KEYBOARD_KEY_STATE_RELEASED, STATE_UPDATE_AUTOMATIC);
+		notify_key(&key_event);
+	}
+	for (i = 0; i < ARRAY_LENGTH(masks); i++) {
+		if (!(peer->last_button_mask & masks[i]))
+			continue;
+		weston_pointer_button_event_init(&button_event, &time, peer->input_seat,
+			buttons[i], WL_POINTER_BUTTON_STATE_RELEASED);
+		notify_button(&button_event);
+	}
+	notify_pointer_frame(peer->input_seat);
+	if (peer->input_seat != peer->seat) {
+		wl_list_remove(&peer->input_seat_destroy.link);
+		weston_seat_release_keyboard(peer->input_seat);
+		weston_seat_release_pointer(peer->input_seat);
+	}
+	wl_array_release(&peer->pressed_keys);
